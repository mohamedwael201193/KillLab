# Copy to .env. Never commit .env. Never put real secrets in this file.
# Names and classes: IMPLEMENTATION_PLAN.md section 20 and the Phase 0 matrix.

# CLI only. Never copy these into the Render or Vercel runtime.
RENDER_API_KEY=
VERCEL_TOKEN=
GITHUB_TOKEN=
GITHUB_REPO=mohamedwael201193/KillLab

# Runtime pooler (port 6543) and migration pooler (port 5432).
# psycopg does not accept a pgbouncer query parameter. The app strips it and sets prepare_threshold=None.
DATABASE_URL=
DIRECT_URL=

# Generated locally with secrets.token_urlsafe(32). Not a vendor credential.
KILLAB_API_TOKEN=
KILLAB_ENV=development

# Optional LLM. Empty means the manual TestSpec path is the supported fallback.
LLM_API_KEY=
# Public handbook defaults. Not a secret. The key is what makes the compiler live.
LLM_BASE_URL=https://hackathon.bitgetops.com/v1
LLM_MODEL=qwen3.8-max
LLM_TIMEOUT_S=30

# Optional private Bitget reads. Public research does not use these.
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
BITGET_HTTP_TIMEOUT_S=20
BITGET_REST_BASE=https://api.bitget.com

# Derived project URL. Unused by v1 SQL. Anon and service-role keys are deliberately unused.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Filled after deploy. Never browser-exposed except the public origin itself.
BACKEND_PUBLIC_URL=
FRONTEND_ORIGIN=

# Reserved. Cookie sessions are not in v1.
SESSION_SECRET=

LOG_LEVEL=INFO
RUN_STALE_MINUTES=15
